      "css": ".ds-time-label{font:12px/1.6 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;color:var(--muted,#596176)}.ds-time-input{font:16px/1.6 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:block;width:100%;padding:10px 12px;margin-top:6px;border:1px solid var(--line,#d8dce6);border-radius:7px;color:var(--ink,#222a40);font-variant-numeric:tabular-nums;caret-color:var(--purple,#584aa3)}.ds-time-input:focus-visible{outline:3px solid var(--purple,#584aa3);outline-offset:3px}"
