{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoughCut Review input",
  "type": "object",
  "properties": {
    "material_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "source_file": {
            "type": "string",
            "maxLength": 12000
          },
          "segment_start": {
            "type": "string",
            "maxLength": 12000
          },
          "segment_end": {
            "type": "string",
            "maxLength": 12000
          },
          "video_duration_seconds": {
            "type": "string",
            "maxLength": 12000
          },
          "transcript": {
            "type": "string",
            "maxLength": 12000
          },
          "role": {
            "type": "string",
            "maxLength": 12000
          },
          "quality_score": {
            "type": "string",
            "maxLength": 12000
          },
          "semantic_score": {
            "type": "string",
            "maxLength": 12000
          },
          "is_duplicate": {
            "type": "string",
            "maxLength": 12000
          },
          "noise_flag": {
            "type": "string",
            "maxLength": 12000
          },
          "overlap_speech_flag": {
            "type": "string",
            "maxLength": 12000
          },
          "off_topic_flag": {
            "type": "string",
            "maxLength": 12000
          },
          "risk_note": {
            "type": "string",
            "maxLength": 12000
          },
          "clip_id": {
            "type": "string",
            "maxLength": 12000
          },
          "duplicate_group": {
            "type": "string",
            "maxLength": 12000
          },
          "language": {
            "type": "string",
            "maxLength": 12000
          },
          "subtitle_en": {
            "type": "string",
            "maxLength": 12000
          },
          "subtitle_zh": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "required": [
          "source_file",
          "segment_start",
          "segment_end",
          "video_duration_seconds",
          "transcript"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "material_rows"
  ],
  "additionalProperties": false
}
