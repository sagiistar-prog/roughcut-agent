{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "ok"
        },
        "mode": {
          "const": "timeline_only"
        },
        "result": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500000
            },
            "csv": {
              "type": "string"
            },
            "timeline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/clip"
              },
              "maxItems": 1000
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/candidate"
              },
              "maxItems": 1000
            },
            "clip_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_duration_seconds": {
              "type": "number",
              "minimum": 0
            },
            "rejected_rows": {
              "type": "array"
            },
            "requires_human_review": {
              "const": true
            }
          },
          "required": [
            "markdown",
            "csv",
            "timeline",
            "candidates",
            "clip_count",
            "total_duration_seconds",
            "rejected_rows",
            "requires_human_review"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "mode",
        "result",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "clip": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "maxLength": 30000
        },
        "transcript": {
          "type": "string",
          "maxLength": 30000
        },
        "role": {
          "type": "string",
          "maxLength": 30000
        },
        "reason": {
          "type": "string",
          "maxLength": 30000
        },
        "risk_note": {
          "type": "string",
          "maxLength": 30000
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "start_time": {
          "type": "number",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "order",
        "source_file",
        "transcript",
        "role",
        "reason",
        "risk_note",
        "start_time",
        "end_time",
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "selected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "maxLength": 30000
            },
            "clip": {
              "type": "null"
            }
          },
          "required": [
            "reason",
            "clip"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "selected": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "maxLength": 30000
            },
            "clip": {
              "$ref": "#/$defs/clip"
            },
            "source_duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "selected",
            "reason",
            "clip",
            "source_duration_seconds"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
